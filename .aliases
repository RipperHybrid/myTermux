#Largest Files
alias largefile="du -h -x -s -- * | sort -r -h | head -20"

#System Information
neo() {
  mkdir -p "${HOME}/.config/mytermux/fetch"
  echo "neo" > "${HOME}/.config/mytermux/fetch/used.log"
  neofetch "$@"
}
neofetch() {
  mkdir -p "${HOME}/.config/mytermux/fetch"
  echo "neo" > "${HOME}/.config/mytermux/fetch/used.log"
  command neofetch "$@"
}
rxfetch() {
  mkdir -p "${HOME}/.config/mytermux/fetch"
  echo "rxfetch" > "${HOME}/.config/mytermux/fetch/used.log"
  if [[ -x "${HOME}/.local/bin/rxfetch" ]]; then
    "${HOME}/.local/bin/rxfetch" "$@"
  else
    command neofetch "$@"
  fi
}
